{:system/env
 #profile {:dev  :dev
           :test :test
           :prod :prod}
 
 :metrics/prometheus
 {}

 :cache/redis
 {:ttl  3600
  :conn {:pool {}
         :spec {:uri #env REDIS_URI}}} 

 :server/http
 {:port    #long #or [#env PORT 3000]
  :host    #or [#env HTTP_HOST "0.0.0.0"]
  :handler #ig/ref :handler/ring}

 :handler/ring
 {:router                #ig/ref :router/core
  :metrics               #ig/ref :metrics/prometheus
  :api-path              "/api"
  :cookie-secret         #or [#env COOKIE_SECRET "XFGHFAMBPIWNKDSU"]
  ;; from ring.middleware.defaults. anti-forgery `false` by default because services may not require it
  :site-defaults-config  {:params    {:urlencoded true
                                      :multipart  true
                                      :nested     true
                                      :keywordize true}
                          :cookies   true
                          :session   {:flash true
                                      :cookie-name "social.mushin.alternative"
                                      :cookie-attrs {:max-age     86400
                                                     :http-only   true
                                                     :same-site   :strict}}
                          :security  {:anti-forgery   false ; TODO prolly want to change this.
                                      :xss-protection {:enable? true, :mode :block}
                                      :frame-options  :sameorigin
                                      :content-type-options :nosniff}
                          :static    {:resources "public"}
                          :responses {:not-modified-responses true
                                      :absolute-redirects     true
                                      :content-types          true
                                      :default-charset        "utf-8"}}}

 :reitit.routes/api
 {:base-path "/api"
  :env       #ig/ref :system/env
  :metrics   #ig/ref :metrics/prometheus
  :depot #ig/ref :social.mushin.alternative.depot/depot
  :bucket #ig/ref :social.mushin.alternative.resources/bucket
  :endpoint #ig/ref :social.mushin.alternative.web.config/endpoint
  :mushin/jwks      #ig/ref :social.mushin.alternative.web.sign/jwk}

 :social.mushin.alternative.web.config/endpoint
 {:url {:host "localhost"}}

 :router/routes
 {:routes #ig/refset :reitit/routes}


 :router/core
 {:routes #ig/ref :router/routes
  :env #ig/ref :system/env} 

 :cronut/scheduler
 {:schedule #profile {:test    []
                      :default [{:job     #ig/ref :social.mushin.alternative.db.tasks/tasks
                                 :trigger #cronut/cron "0 0 1 * * ?"}]}
  :disallowConcurrentExecution? true}

 :social.mushin.alternative.resources/bucket
 {:local
  ;; HERE: Change these two values.
  {:path "./test_media"
   :endpoint "http://media.localhost/res/"}}

 ;; Database regular tasks.
 :social.mushin.alternative.db.tasks/tasks
 {:identity  "social.mushin.alternative.db.tasks/tasks"
  :description "Perform background tasks on the database."
  :depot #ig/ref :social.mushin.alternative.depot/depot
  :recover? true
  :durable? true}

 :social.mushin.alternative.web.sign/jwk
 {:priv "./test_key_priv.pem"
  :pub "./test_key_pub.pem"}

 :social.mushin.alternative.cache/local-cache
 {}

 :db/db
 {:db-spec
  {:dbtype "sqlite"
   :dbname "data/test.db"
   :maximumPoolSize 1}}

 :services/executor
 {}

 :alternative/depot
 {:executor #ig/ref :services/executor
  :db #ig/ref :db/db
  :cache #ig/ref :social.mushin.alternative.cache/local-cache
  :bucket #ig/ref :social.mushin.alternative.resources/bucket}}

